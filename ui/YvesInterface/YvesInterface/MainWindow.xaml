<Window x:Class="YvesInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YvesInterface"
        mc:Ignorable="d"
        Title="Yves" Height="450" Width="800">
    <Grid>
        <Grid Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <TextBlock Text="INVENTORY" Foreground="White" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <Button Content="Sync Memory" DockPanel.Dock="Bottom" Background="#3E3E42" Foreground="White" Click="Sync_Click"/>
                    <ListBox x:Name="FileListView" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatDisplay" VerticalAlignment="Bottom">
                    </StackPanel>
                </ScrollViewer>

                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="SendBtn" Content="Send" DockPanel.Dock="Right" 
                Width="80" Height="30" Margin="10,0,0,0" 
                Background="#007ACC" Foreground="White" Click="Send_Click" IsDefault="True"/>
                    <TextBox x:Name="InputBox" Padding="10" Background="#333333" 
                 Foreground="White" BorderBrush="#555555" FontSize="14"
                 KeyDown="InputBox_KeyDown" VerticalContentAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
